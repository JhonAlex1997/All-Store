{
  "info": {
    "name": "AllStore API",
    "description": "Colección para probar AllStore.\n\n1. Ejecuta **00 Sesión > Login**: guarda el token en la variable `token`.\n2. Todas las demás peticiones lo envían solas (Authorization: Bearer).\n3. Cambia `baseUrl` en las variables de la colección si el servidor no está en localhost:8080.\n\nUsuarios demo (perfil dev): admin, cajero, almacenero. Contraseña: la de `app.demo.password` en application-dev.properties.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "Demo2026allstore"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenCajero",
      "value": ""
    },
    {
      "key": "codigoProducto",
      "value": ""
    },
    {
      "key": "productoId",
      "value": ""
    },
    {
      "key": "varianteId",
      "value": ""
    },
    {
      "key": "codigoBarras",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "dni",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Sesión",
      "item": [
        {
          "name": "Login (guarda el token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login correcto\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", json.accessToken);",
                  "console.log(\"Sesion iniciada como \" + json.usuario.username + \" (\" + json.usuario.rol + \")\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi perfil",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cambiar mi contraseña",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/cambiar-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passwordActual\": \"{{password}}\",\n  \"passwordNueva\": \"NuevaClave2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Cuidado: cambia la contraseña real del usuario. Si responde 200, la colección guarda la nueva contraseña y el nuevo token (el anterior deja de valer)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().accessToken);",
                  "pm.collectionVariables.set(\"password\", JSON.parse(pm.request.body.raw).passwordNueva);"
                ]
              }
            }
          ]
        }
      ]
    },
