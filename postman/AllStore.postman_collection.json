        {
          "name": "Crear producto con variantes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/productos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{codigoProducto}}\",\n  \"nombre\": \"Jean de prueba Postman\",\n  \"categoriaId\": 1,\n  \"precioVenta\": 89.9,\n  \"tallaIds\": [\n    3,\n    4,\n    5\n  ],\n  \"colorIds\": [\n    1,\n    3\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Crea 6 variantes (3 tallas x 2 colores). Guarda productoId, varianteId y codigoBarras para las siguientes peticiones."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"codigoProducto\", \"PM\" + Date.now().toString().slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.test(\"Genero 6 variantes\", () => pm.expect(p.variantes.length).to.eql(6));",
                  "pm.collectionVariables.set(\"productoId\", p.id);",
                  "pm.collectionVariables.set(\"varianteId\", p.variantes[0].id);",
                  "pm.collectionVariables.set(\"codigoBarras\", p.variantes[0].codigoBarras);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver producto con variantes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/productos/{{productoId}}"
