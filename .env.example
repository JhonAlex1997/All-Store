# Copia este archivo como .env (no se sube a git) y completa los valores reales.
DB_URL=jdbc:postgresql://localhost:5432/allstore
DB_USERNAME=postgres
DB_PASSWORD=
SERVER_PORT=8080

# Perfil local: dev = Swagger + datos de demostración. En producción no se define.
spring.profiles.active=dev

# Base de las pruebas automáticas (opcional; por defecto localhost:5432/allstore_test).
