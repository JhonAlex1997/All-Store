# Copia este archivo como .env (no se sube a git) y completa los valores reales.
DB_URL=jdbc:postgresql://localhost:5432/allstore
DB_USERNAME=postgres
DB_PASSWORD=
SERVER_PORT=8080

# Clave para firmar los tokens de sesión: aleatoria, mínimo 32 caracteres, distinta en cada
# entorno. Genera una con:  openssl rand -base64 48
JWT_SECRET=

# Contraseña del primer administrador (opcional). Si se deja vacía, se genera una y se muestra
# una sola vez en el log del primer arranque.
# ADMIN_PASSWORD_INICIAL=

# Orígenes del frontend autorizados (separados por coma).
# CORS_ORIGENES=http://localhost:4200

# Perfil local: dev = Swagger + datos de demostración. En producción no se define.
spring.profiles.active=dev

# Base de las pruebas automáticas (opcional; por defecto localhost:5432/allstore_test).
# TEST_DB_URL=jdbc:postgresql://localhost:5432/allstore_test
